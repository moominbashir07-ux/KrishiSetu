# =============================================================================
# KrishiSetu — Environment Configuration Template
# Clean, Zero-Cost Architecture (Zero AWS / Zero Paid AI Dependency)
# =============================================================================

# Server Environment
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL / Local fallback)
DATABASE_URL=postgresql://postgres:password@localhost:5432/krishisetu

# Storage Configuration ('local')
STORAGE_PROVIDER=local

# Security & Authentication Secrets
JWT_SECRET=replace_with_a_secure_random_string_in_production
ADMIN_BOOTSTRAP_KEY=replace_with_a_secure_admin_bootstrap_key

# Government Mandi Market Rates API (data.gov.in / AGMARKNET)
# Register at https://data.gov.in to obtain an official API key.
# Leave blank to use official AGMARKNET public daily feeds / cached snapshots.
DATA_GOV_IN_API_KEY=

# Email / OTP Provider ('emailjs' or 'dev')
EMAIL_OTP_PROVIDER=dev
EMAILJS_PUBLIC_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAIL_FROM=
