# =============================================================================
# KrishiSetu 2.0 — Environment Configuration Template
# NOTE: DO NOT COMMIT SENSITIVE SECRETS OR REAL CREDENTIALS TO SOURCE CONTROL.
# =============================================================================

# Server Environment
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# AWS Core Configuration (Ship It Hackathon Track)
AWS_REGION=ap-south-1
AWS_DYNAMODB_TABLE=KrishiSetuProducts
AWS_S3_MEDIA_BUCKET=krishisetu-evidence-2026

# Storage Provider Configuration ('lambda', 's3', or mock fallback)
STORAGE_PROVIDER=lambda
AWS_LAMBDA_STORAGE_URL=https://<lambda-id>.lambda-url.ap-south-1.on.aws/

# Amazon Cognito Identity
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Amazon Bedrock Generative AI Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_REGION=us-east-1

# Government Mandi Market Rates API (data.gov.in)
# Register at https://data.gov.in to obtain an official API key.
# Leave blank or set to 'development_mock' to activate the MockMarketAdapter in local dev.
DATA_GOV_IN_API_KEY=

# Local Emulation & Development Options
# Set to 'true' to use local in-memory/DynamoDB-local storage during offline testing
USE_LOCAL_EMULATION=true

# Security Secrets (Local JWT fallback when Cognito offline)
JWT_SECRET=replace_with_a_secure_random_string_in_production
